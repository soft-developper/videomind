# Dependencies
node_modules/

# Environment files — never commit these
.env
.env.local


# Build outputs
dist/
.next/
out/

# Uploads temp folder
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Turso local dev db (if any)
*.db
*.db-shm
*.db-wal

# Patch script backups (kept locally for --revert, never committed)
.vm_*_backups/
*.bak-*
.vercel
.env*

# vm scripts: their backups, file backups, and lock files outside a package (keep them out of git)
.vm_*_backups/
*.bak.*
/package-lock.json
