# ─── Shelbynet (NOT Aptos Testnet, a separate network) ────
# Fullnode:  https://api.shelbynet.shelby.xyz/v1
# Faucet:    https://faucet.shelbynet.shelby.xyz
# Explorer:  https://explorer.shelby.xyz/shelbynet
#
# Fund this account via the shelbynet faucet above, not the Aptos
# testnet faucet. They are different networks with separate balances.
APTOS_PRIVATE_KEY=ed25519-priv-0x...
APTOS_ACCOUNT_ADDRESS=0x...
APTOS_API_KEY=aptoslabs_...
# vm_anchors: a store on Shelby is confirmed from the shelbynet object index
# and the Shelby contract (sent with APTOS_API_KEY when it is set). Optional:
# SHELBY_INDEXER_URL=https://api.shelbynet.aptoslabs.com/v1/graphql
# SHELBY_FULLNODE_URL=https://api.shelbynet.shelby.xyz/v1
# How many times a new store is looked up before it is marked not confirmed (default 6).
# ANCHOR_CHECK_ATTEMPTS=6
# vm_clips: clips cut from a video. Optional:
# Longest quick cut and social clip, in seconds (defaults 600 and 90).
# CLIP_CUT_MAX_SECONDS=600
# CLIP_SOCIAL_MAX_SECONDS=90
# Social clips one wallet may start per day (default 20). Each is minutes of encoding.
# CLIP_SOCIAL_PER_DAY=20
# A folder of .ttf or .otf fonts for drawing captions, when the server has no
# system fonts. /api/health shows media.captions true when captions can be drawn.
# CLIP_FONTS_DIR=/opt/render/project/src/backend/fonts

# ─── Turso Database ────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db-name-orgname.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── AI APIs ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Server ───────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── File storage ─────────────────────────────────────────
# Leave all of these unset to keep files on local disk (development
# only: on Render a deploy wipes the disk).
# Set them to keep files in any S3 compatible store.
# For Cloudflare R2: endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# and region is auto.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=videomind-rebuild
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Optional. Set to false to delete the original after processing.
# Videos then only play once they are stored on Shelby.
# STORAGE_KEEP_ORIGINAL=true
# Optional. Largest upload in bytes (default 10 GB).
# UPLOAD_MAX_BYTES=10737418240
# Optional. Days before an unfinished upload is discarded (default 7).
# UPLOAD_EXPIRE_DAYS=7
#
# The browser sends files straight to the bucket, so the bucket needs a
# CORS policy that allows PUT, GET and HEAD from the site's address.

# ─── Transcription ────────────────────────────────────────
# vm_transcribe: the sound is taken out with FFmpeg and sent to whisper-1
# in pieces cut at pauses. Both settings are optional.
# Longest recording that is transcribed, in hours (default 4).
# TRANSCRIBE_MAX_HOURS=4
# Length of one piece in seconds (default 600). Lower only for testing.
# TRANSCRIBE_CHUNK_SECONDS=600

# ─── Claude ───────────────────────────────────────────────
# vm_claude: summaries, chapters, chat and search use one model, and
# picking the videos a library question is about uses a small fast one.
# All three settings are optional.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MODEL_FAST=claude-haiku-5-5
# How hard the model thinks: low, medium, high, xhigh or max.
# Unset means the model's own default.
# CLAUDE_EFFORT=

# ─── Search ───────────────────────────────────────────────
# vm_search: transcripts are cut into passages and embedded with OpenAI's
# text-embedding-3-small (uses OPENAI_API_KEY above). The vectors live in
# the Turso database (table passages). Optional:
# How alike a passage must be to a search to be listed (0 to 1, default 0.15).
# SEARCH_MIN_SCORE=0.15
# Searches per client per 10 minutes (default 120). Search does not call Claude.
# LIMIT_SEARCH_PER_CLIENT_10MIN=120
# vm_knowledge: answers a shared video gives to people other than its
# owner in a day (default 100). The owner pays for every answer, so this
# caps what a widely shared link can cost. The owner is never limited.
# ASK_BUDGET_PER_VIDEO_DAY=100

# vm_live: live events through LiveKit (Cloud or your own server). Without
# these three, Go live is switched off. From the LiveKit project's settings:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Most viewers at once per event (default 100, the LiveKit free plan's limit).
# LIVE_MAX_VIEWERS=100
# Live events one wallet may create per day (default 10).
# LIVE_EVENTS_PER_DAY=10

# vm_youtube: publishing to the owner's YouTube channel. Without the first
# three, Publish to YouTube is switched off. From a Google Cloud project with
# the YouTube Data API v3 enabled, an OAuth client of type "Web application"
# whose authorized redirect URI is <API_PUBLIC_URL>/api/youtube/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# This backend's public address (on Render, RENDER_EXTERNAL_URL is used if unset).
# API_PUBLIC_URL=https://videomind-rebuild.onrender.com
# 32 random bytes in base64 that encrypt stored YouTube permissions. Optional:
# without it a key is derived from GOOGLE_CLIENT_SECRET. Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# YOUTUBE_TOKEN_KEY=
# Uploads one wallet may start per day (default 10), and for everyone
# together (default 90; Google allows 100 a day per Cloud project).
# YOUTUBE_UPLOADS_PER_DAY=10
# YOUTUBE_UPLOADS_PROJECT_DAY=90
